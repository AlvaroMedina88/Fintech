{
  "provider": "Dotnet",
  "packages": {
    "dotnet": "10.0"
  },
  "steps": {
    "install": {
      "cmds": [
        "mkdir -p /root/.nuget/packages",
        "dotnet restore FinTech.sln"
      ]
    },
    "build": {
      "cmds": [
        "dotnet publish Presentacion/FinTech.Api/FinTech.Api.csproj --no-restore -c Release -o out"
      ]
    }
  },
  "start": {
    "cmd": "./out/FinTech.Api"
  }
}
